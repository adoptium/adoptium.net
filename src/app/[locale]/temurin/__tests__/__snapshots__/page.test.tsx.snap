      class="max-w-[832px] w-full mx-auto md:py-0 py-8 flex justify-center items-center flex-col text-center bg-transparent rounded-3xl md:backdrop-blur-0 backdrop-blur-12"
    >
      <img
        alt="message icon"
        class="!mb-0"
        height="120"
        src="/images/icons/message.svg"
        width="120"
      />
      <p
        class="text-white text-4xl md:text-5xl leading-[122.222%] md:leading-[116.667%] font-normal mt-8 mb-6"
      >
        Speak to our team today
      </p>
      <span
        class="text-gray-300 text-base leading-6"
      >
        Ready to get involved? Fill out our membership form and take the first step in shaping the future of Adoptium.
      </span>
      <a
        href="/join"
      >
        <button
          class="bg-transparent mt-10 border-2 border-pink-500/0 text-white text-base leading-6 font-bold w-[191px] h-[48px] rounded-2xl gradient-border"
        >
          Contact Us
        </button>
      </a>
    </div>
  </section>
</div>
`;
