          class="inline-flex items-center gap-2 rounded-xl bg-pink px-5 py-3 text-sm font-semibold text-white hover:bg-pink/80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pink"
          href="/join"
        >
          <span>
            Contact us
          </span>
          <svg
            aria-hidden="true"
            fill="none"
            height="1em"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="1em"
            xmlns="http://www.w3.org/2000/svg"
          >
            <line
              x1="5"
              x2="19"
              y1="12"
              y2="12"
            />
            <polyline
              points="12 5 19 12 12 19"
            />
          </svg>
        </a>
        <a
          class="text-sm text-[#ff91b7] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-pink"
          href="/slack"
        >
          Talk to the community
        </a>
      </div>
    </div>
  </section>
</div>
`;
