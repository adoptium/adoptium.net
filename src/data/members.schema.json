{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "logo": {
        "type": "string"
      },
      "logo_white": {
        "type": "string"
      },
      "logoPadding": {
        "type": "string"
      },
      "logoDisplay": {
        "type": "object",
        "description": "Optical sizing and asset overrides for adopter and member logos.",
        "properties": {
          "src": {
            "type": "string"
          },
          "maxWidth": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "monochrome": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "url": {
        "type": "string",
        "pattern": "^https://[^\\s/$.?#].[^\\s]*$"
      },
      "tier": {
        "type": "string",
        "enum": [
          "adopter",
          "strategic",
          "enterprise",
          "participant",
          "sponsor",
          "infra"
        ]
      },
      "featured": {
        "type": "boolean"
      }
    },
    "required": ["name", "logo", "url", "tier"],
    "additionalProperties": false
  }
}
